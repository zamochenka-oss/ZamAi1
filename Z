const INTENT_LIST = Object.keys(INTENTS);

// =====================================================
//  ТОКЕНИЗАЦИЯ
// =====================================================
function tokenize(text) {
  return text.toLowerCase().replace(/[^\wа-яё\s]/gi, ' ').split(/\s+/).filter(w => w.length > 1);
}

function encodeText(text) {
  const tokens = tokenize(text);
  const lower = text.toLowerCase();
  const vector = [];
  for (const intent of INTENT_LIST) {
    let score = 0;
    for (const kw of INTENTS[intent].keywords) {
      if (kw.includes(' ') || kw.length > 4) {
        if (lower.includes(kw)) score += 3;
      }
      for (const t of tokens) {
        if (t === kw) score += 3;
        else if (kw.length >= 4 && t.includes(kw)) score += 1;
      }
    }
    vector.push(score);
  }
  return vector;
}

// =====================================================
//  ПРОВЕРКА МАТА
// =====================================================
function containsSwearing(text) {
  const swearWords = ['бля','хуй','пизд','ебан','ебал','ебать','ебут','сука','нахуй','ахуе','охуе','заеб','долбоеб','мудак','говно','хер','пиздец','дерьмо'];
  const lower = text.toLowerCase();
  return swearWords.some(w => lower.includes(w));
}

// =====================================================
//  НЕЙРОСЕТЬ
// =====================================================
class IntentNet {
  constructor(inp, out) {
    this.inputSize = inp;
    this.outputSize = out;
    this.weights = [];
    for (let i = 0; i < out; i++) {
      this.weights[i] = [];
      for (let j = 0; j < inp; j++) this.weights[i][j] = (Math.random() * 2 - 1) * 0.5;
    }
  }
  forward(input) {
    const raw = [];
    for (let i = 0; i < this.outputSize; i++) {
      let sum = 0;
      for (let j = 0; j < this.inputSize; j++) sum += input[j] * this.weights[i][j];
      raw.push(sum);
    }
    const max = Math.max(...raw);
    const exps = raw.map(v => Math.exp(v - max));
    const sumExp = exps.reduce((a, b) => a + b, 0);
    return exps.map(v => v / sumExp);
  }
  train(input, correctIdx, lr = 0.15) {
    const probs = this.forward(input);
    const target = probs.map((_, i) => i === correctIdx ? 1 : 0);
    for (let i = 0; i < this.outputSize; i++) {
      const err = target[i] - probs[i];
      for (let j = 0; j < this.inputSize; j++) this.weights[i][j] += lr * err * input[j];
    }
  }
}

const net = new IntentNet(INTENT_LIST.length, INTENT_LIST.length);
for (let epoch = 0; epoch < 500; epoch++) {
  for (let i = 0; i < INTENT_LIST.length; i++) {
    const v = INTENT_LIST.map((_, j) => i === j ? 1 : 0);
    net.train(v, i, 0.15);
  }
}

// =====================================================
//  ОПРЕДЕЛЕНИЕ НАМЕРЕНИЯ
// =====================================================
function detectIntent(text) {
  const lower = text.toLowerCase().trim();
  for (const trigger in memory.learned) {
    if (lower === trigger || lower.includes(trigger)) {
      return { intent: 'learned', confidence: 1, learnedAnswer: memory.learned[trigger] };
    }
  }
  const vec = encodeText(text);
  const total = vec.reduce((a, b) => a + b, 0);
  if (total === 0) return { intent: null, confidence: 0 };
  const probs = net.forward(vec);
  let bestIdx = 0, bestP = 0;
  for (let i = 0; i < probs.length; i++) {
    if (probs[i] > bestP) { bestP = probs[i]; bestIdx = i; }
  }
  return { intent: INTENT_LIST[bestIdx], confidence: bestP };
}

// =====================================================
//  КОМАНДЫ
// =====================================================
function parseCommand(text) {
  const lower = text.toLowerCase().trim();

  // === ОБУЧЕНИЕ ЧЕРЕЗ ДИАЛОГ ===
  // 1. Если бот в режиме обучения и пользователь присылает ответ
  if (memory.isLearning) {
    return { type: 'learning_answer', value: text };
  }

  // 2. "чему научи меня" / "учи меня" / "хочешь научиться"
  if (/чему\s*(меня\s*)?научи|научи\s*меня|давай\s*научи|хочешь\s*научи|учи\s*меня|чему\s*хочешь\s*научиться/.test(lower)) {
    return { type: 'start_learning' };
  }

  // 3. Прямое обучение: "запомни: фраза = ответ"
  let m = lower.match(/^запомни\s*[:\s]+(.+?)\s*[=\-—>]+\s*(.+)$/);
  if (m) return { type: 'learn', trigger: m[1].trim(), response: m[2].trim() };

  // 4. Повтори
  m = lower.match(/^(?:повтори|скажи|напиши|выведи)\s*(?:за мной)?[:\s]+(.+)$/);
  if (m) return { type: 'repeat', value: m[1] };
  if (/^(?:повтори|скажи|напиши|выведи)\s*(?:за мной)?[.!?]?$/.test(lower)) {
    return { type: 'repeat_last' };
  }

  // 5. "меня зовут X"
  m = lower.match(/^меня зовут\s+(.+)$/);
  if (m) return { type: 'set_name', value: m[1].trim() };

  // 6. Список выученного
  if (/чему\s*(ты\s*)?научился|что\s*ты\s*знаешь|твоя\s*память|список/.test(lower)) {
    return { type: 'list_learned' };
  }

  // 7. Забудь всё
  if (/забудь всё|очисти память|сброс/.test(lower)) {
    return { type: 'forget' };
  }

  // 8. Время
  if (/сколько\s*времени|который\s*час/.test(lower)) return { type: 'time' };

  // 9. Дата
  if (/какое\s*(сегодня\s*)?число|какой\s*день|дата/.test(lower)) return { type: 'date' };

  // 10. Математика
  const mathMatch = text.match(/^(-?\d+(?:\.\d+)?)\s*([+\-*/×÷])\s*(-?\d+(?:\.\d+)?)$/);
  if (mathMatch) return { type: 'math', a: parseFloat(mathMatch[1]), op: mathMatch[2], b: parseFloat(mathMatch[3]) };

  return null;
}

// =====================================================
//  ГЛАВНЫЙ ОТВЕТ
// =====================================================
function generateReply(text) {
  // === МАТ ОТ ПОЛЬЗОВАТЕЛЯ ===
  if (containsSwearing(text)) {
    memory.userSwore = true;
    saveMemory();
  }

  const cmd = parseCommand(text);

  if (cmd) {
    // Ответ на обучение
    if (cmd.type === 'learning_answer') {
      const q = memory.learningQuestion;
      memory.learned[q] = cmd.value;
      memory.isLearning = false;
      memory.learningQuestion = '';
      saveMemory();
      return {
        text: `Запомнил! Теперь на «${q}» отвечаю: «${cmd.value}»`,
        learned: true
      };
    }

    // Начало обучения
    if (cmd.type === 'start_learning') {
      const questions = [
        'Что ты любишь есть?',
        'Какой у тебя любимый фильм?',
        'Чем занимаешься в свободное время?',
        'Кем хочешь стать?',
        'Какой у тебя любимый цвет?',
        'Что тебя бесит?',
        'Какой твой любимый предмет в школе?',
        'Что слушаешь из музыки?'
      ];
      const q = questions[Math.floor(Math.random() * questions.length)];
      memory.isLearning = true;
      memory.learningQuestion = q;
      return {
        text: `Окей, давай поучимся!\n\n${q}\n\nНапиши ответ — я запомню.`,
        learned: false
      };
    }

    // Обучение через "запомни: x = y"
    if (cmd.type === 'learn') {
      memory.learned[cmd.trigger] = cmd.response;
      saveMemory();
      return {
        text: `Запомнил! На «${cmd.trigger}» отвечу: «${cmd.response}»`,
        learned: true
      };
    }

    // Повторить
    if (cmd.type === 'repeat') return { text: cmd.value, learned: false };
    if (cmd.type === 'repeat_last') return { text: memory.lastUserMessage || 'Ты ещё не говорил.', learned: false };

    // Имя
    if (cmd.type === 'set_name') {
      memory.facts.name = cmd.value;
      saveMemory();
      return { text: `Приятно познакомиться, ${cmd.value}! Запомнил.`, learned: true };
    }

    // Список выученного
    if (cmd.type === 'list_learned') {
      const keys = Object.keys(memory.learned);
      const factKeys = Object.keys(memory.facts);
      let result = '';
      if (keys.length > 0) {
        result += `Выучено (${keys.length}):\n` + keys.map(k => `• «${k}» → «${memory.learned[k]}»`).join('\n');
      }
      if (factKeys.length > 0) {
        result += (result ? '\n\n' : '') + `Факты:\n` + factKeys.map(k => `• ${k}: ${memory.facts[k]}`).join('\n');
      }
      if (!result) result = 'Пока пусто. Скажи «научи меня» или «запомни: фраза = ответ».';
      return { text: result, learned: false };
    }

    // Забудь
    if (cmd.type === 'forget') {
      memory.learned = {};
      memory.facts = {};
      saveMemory();
      return { text: 'Память очищена.', learned: false };
    }

    // Время
    if (cmd.type === 'time') {
      const now = new Date();
      return { text: `Сейчас ${now.getHours()}:${String(now.getMinutes()).padStart(2,'0')}`, learned: false };
    }

    // Дата
    if (cmd.type === 'date') {
      const now = new Date();
      const days = ['воскресенье','понедельник','вторник','среда','четверг','пятница','суббота'];
      const months = ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
      return { text: `Сегодня ${days[now.getDay()]}, ${now.getDate()} ${months[now.getMonth()]} ${now.getFullYear()}`, learned: false };
    }

    // Математика
    if (cmd.type === 'math') {
      const { a, op, b } = cmd;
      let result;
      if (op === '+') result = a + b;
      else if (op === '-') result = a - b;
      else if (op === '*' || op === '×') result = a * b;
      else if (op === '/' || op === '÷') {
        if (b === 0) return { text: 'На ноль делить нельзя!', learned: false };
        result = a / b;
      }
      return { text: `${a} ${op} ${b} = ${result}`, learned: false };
    }
  }

  // === ОПРЕДЕЛЕНИЕ НАМЕРЕНИЯ ===
  const { intent, confidence, learnedAnswer } = detectIntent(text);
  if (intent === 'learned' && learnedAnswer) {
    return { text: learnedAnswer, learned: false };
  }

  // === МАТ ОТ ПОЛЬЗОВАТЕЛЯ → ОТВЕТ С МАТОМ ===
  if (memory.userSwore && containsSwearing(text)) {
    const swearReplies = INTENTS.swearing.responses;
    return { text: swearReplies[Math.floor(Math.random() * swearReplies.length)], learned: false };
  }

  if (intent && confidence > 0.4) {
    const responses = INTENTS[intent].responses;
    if (responses && responses.length > 0) {
      return { text: responses[Math.floor(Math.random() * responses.length)], learned: false };
    }
  }

  // Если спросили имя
  if (/как меня зовут|моё имя/.test(text.toLowerCase())) {
    if (memory.facts.name) return { text: `Тебя зовут ${memory.facts.name}!`, learned: false };
    return { text: 'Не говорил ещё. Скажи «меня зовут ...» — запомню.', learned: false };
  }

  // Если мат — отвечаем матом
  if (containsSwearing(text)) {
    const swearReplies = INTENTS.swearing.responses;
    return { text: swearReplies[Math.floor(Math.random() * swearReplies.length)], learned: false };
  }

  // === НЕ ЗНАЮ ОТВЕТА ===
  const fallbacks = [
    `Хм, не догнал. Что ответить на «${text}»? Напиши: «запомни: ${text} = ответ».`,
    `Не знаю, что сказать. Научи: «запомни: фраза = ответ».`,
    `Не могу найти ответ. Напиши «научи меня» — я сам спрошу.`,
    `Хз. Расскажи, что отвечать на «${text}» — запомню.`
  ];
  return { text: fallbacks[Math.floor(Math.random() * fallbacks.length)], learned: false };
}

// =====================================================
//  ЧАТ
// =====================================================
const chatEl = document.getElementById('chat');
const inputEl = document.getElementById('messageInput');
const sendBtn = document.getElementById('sendBtn');
let isTyping = false;

function addMessage(role, text, learned = false) {
  const msg = document.createElement('div');
  msg.className = 'msg ' + role;
  const avatarText = role === 'user' ? 'Я' : '🧠';
  const nameText = role === 'user' ? 'Ты' : 'ZamAI Pro';

  msg.innerHTML = `
    <div class="msg-avatar">${avatarText}</div>
    <div class="msg-body">
      <div class="msg-name">${nameText}${learned ? '<span class="learned-tag">научился</span>' : ''}</div>
      <div class="msg-content"></div>
    </div>
  `;
  chatEl.appendChild(msg);

  const contentEl = msg.querySelector('.msg-content');
  if (role === 'bot') typeText(contentEl, text);
  else {
    contentEl.textContent = text;
    scrollToBottom();
  }
}

function typeText(el, text) {
  isTyping = true;
  sendBtn.disabled = true;

  const textSpan = document.createElement('span');
  const cursorSpan = document.createElement('span');
  cursorSpan.className = 'cursor';
  el.appendChild(textSpan);
  el.appendChild(cursorSpan);

  let i = 0;
  const speed = text.length > 150 ? 6 : text.length > 80 ? 10 : 16;

  function step() {
    if (i < text.length) {
      textSpan.textContent += text[i];
      i++;
      if (i % 5 === 0) scrollToBottom();
      setTimeout(step, speed);
    } else {
      cursorSpan.remove();
      isTyping = false;
      sendBtn.disabled = false;
      inputEl.focus();
      scrollToBottom();
    }
  }
  setTimeout(step, 200);
}

function scrollToBottom() { chatEl.scrollTop = chatEl.scrollHeight; }

function sendMessage() {
  if (isTyping) return;
  const text = inputEl.value.trim();
  if (!text) return;

  memory.repeatCount[text] = (memory.repeatCount[text] || 0) + 1;
  memory.lastUserMessage = text;
  memory.history.push({ role: 'user', text });
  if (memory.history.length > 30) memory.history.shift();

  addMessage('user', text);
  inputEl.value = '';
  inputEl.style.height = 'auto';

  setTimeout(() => {
    const reply = generateReply(text);
    memory.lastBotReply = reply.text;
    memory.history.push({ role: 'bot', text: reply.text });
    addMessage('bot', reply.text, reply.learned);
  }, 250);
}

function sendQuick(text) {
  inputEl.value = text;
  sendMessage();
}

inputEl.addEventListener('input', () => {
  inputEl.style.height = 'auto';
  inputEl.style.height = Math.min(inputEl.scrollHeight, 120) + 'px';
});
inputEl.addEventListener('keydown', (e) => {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    sendMessage();
  }
});

loadMemory();

window.addEventListener('load', () => {
  setTimeout(() => {
    addMessage('bot', 'Здарова! Я ZamAI Pro — свободный чат без фильтров.\n\nЧто умею:\n• Болтать на любые темы (жизнь, игры, учёба, деньги, отношения)\n• Считать (2+2)\n• Шутить\n• Ругаться матом (как ты)\n• Учиться (скажи «научи меня»)\n• Запоминать\n\nПогнали?');
  }, 500);
});

inputEl.focus();
</script>

