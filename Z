function loadMemory() {
  try {
    const saved = localStorage.getItem('zamai_free_memory');
    if (saved) {
      const data = JSON.parse(saved);
      memory.learned = data.learned || {};
      memory.facts = data.facts || {};
      memory.repeatCount = data.repeatCount || {};
      memory.userSwore = data.userSwore || false;
    }
  } catch(e) {}
}
function saveMemory() {
  try {
    localStorage.setItem('zamai_free_memory', JSON.stringify({
      learned: memory.learned,
      facts: memory.facts,
      repeatCount: memory.repeatCount,
      userSwore: memory.userSwore
